# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Database (local Postgres from `pnpm docker:deps`)
DATABASE_URL=postgresql://vlp:change-me-local-only@localhost:5432/vlp?schema=public

# ---- Storage -------------------------------------------------------------------------------
# LOCAL (default in dev): files go to ./storage on this machine.
STORAGE_LOCAL_ENABLED=true
LOCAL_STORAGE_DIR=storage
# S3 via LocalStack (`docker compose --profile aws up -d localstack`). Leave VIDEOS_BUCKET empty
# to disable S3 locally. These test credentials only work against LocalStack.
VIDEOS_BUCKET=
S3_ENDPOINT=http://localhost:4566
S3_FORCE_PATH_STYLE=true
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Uploads
UPLOAD_URL_TTL_SEC=3600
MULTIPART_THRESHOLD_BYTES=67108864
MULTIPART_PART_SIZE_BYTES=16777216
