# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Database (local Postgres from `pnpm docker:deps`)
DATABASE_URL=postgresql://vlp:change-me-local-only@localhost:5432/vlp?schema=public
