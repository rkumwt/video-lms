NODE_ENV=development
LOG_LEVEL=debug
DATABASE_URL=postgresql://vlp:change-me-local-only@localhost:5432/vlp?schema=public
# LocalStack (`docker compose --profile aws up -d localstack`); leave the queue URL empty to idle.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
VIDEO_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/vlp-video-events
VIDEOS_BUCKET=vlp-videos-local
S3_ENDPOINT=http://localhost:4566
S3_FORCE_PATH_STYLE=true
WORKER_CONCURRENCY=2
