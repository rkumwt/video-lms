{
  "name": "learning-video-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "husky",
    "docker:deps": "docker compose up -d postgres",
    "docker:up": "docker compose --profile app up -d --build",
    "docker:down": "docker compose --profile app --profile aws down",
    "docker:logs": "docker compose --profile app logs -f",
    "db:migrate": "pnpm --filter @vlp/db migrate:dev",
    "db:deploy": "pnpm --filter @vlp/db migrate:deploy",
    "db:status": "pnpm --filter @vlp/db migrate:status",
    "db:studio": "pnpm --filter @vlp/db studio",
    "db:seed": "pnpm --filter @vlp/db seed"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3"
  }
}
